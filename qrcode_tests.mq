include "test"
| include "qrcode"
|

# -- Integer bit helpers --

def test_xor_basic():
  assert_eq(_qr_xor(5, 3), 6)
end

def test_xor_zero():
  assert_eq(_qr_xor(0, 7), 7)
end

def test_xor_equal_values():
  assert_eq(_qr_xor(42, 42), 0)
end

def test_bit_length_zero():
  assert_eq(_qr_bit_length(0), 0)
end

def test_bit_length_255():
  assert_eq(_qr_bit_length(255), 8)
end

def test_bit_length_256():
  assert_eq(_qr_bit_length(256), 9)
end

def test_bits_of_mode_indicator():
  assert_eq(_qr_bits_of(4, 4), [0, 1, 0, 0])
end

def test_bits_of_byte():
  assert_eq(_qr_bits_of(65, 8), [0, 1, 0, 0, 0, 0, 0, 1])
end

def test_bits_of_zero_length():
  assert_empty(_qr_bits_of(5, 0))
end

def test_bit_at():
  let value = 5
  | assert_eq(_qr_bit_at(value, 0), 1)
  | assert_eq(_qr_bit_at(value, 1), 0)
  | assert_eq(_qr_bit_at(value, 2), 1)
end

# -- GF(256) arithmetic --

def test_gf_mul_basic():
  assert_eq(_qr_gf_mul(2, 3, _qr_gf_exp_table(), _qr_gf_log_table()), 6)
end

def test_gf_mul_zero():
  assert_eq(_qr_gf_mul(0, 200, _qr_gf_exp_table(), _qr_gf_log_table()), 0)
end

def test_gf_mul_identity():
  assert_eq(_qr_gf_mul(1, 200, _qr_gf_exp_table(), _qr_gf_log_table()), 200)
end

def test_gf_mul_overflow_wraps_in_field():
  # 200 * 200 must stay inside GF(256), i.e. a valid byte
  let result = _qr_gf_mul(200, 200, _qr_gf_exp_table(), _qr_gf_log_table())
  | assert_true(result >= 0 && result <= 255)
end

# -- Reed-Solomon --

def test_generator_poly_degree_2():
  assert_eq(_qr_generator_poly(2, _qr_gf_exp_table(), _qr_gf_log_table()), [1, 3, 2])
end

def test_rs_encode_known_vector():
  # Cross-checked against an independent Python implementation and the
  # `reedsolo` library for the same message and error correction count.
  let data = [32, 91, 11, 120, 209, 114, 220, 77, 67, 64, 236, 17, 236, 17, 236]
  | let ecc = _qr_rs_encode_block(data, 10, _qr_gf_exp_table(), _qr_gf_log_table())
  | assert_eq(ecc, [122, 57, 137, 9, 58, 155, 238, 181, 73, 165])
end

# -- Block info table (versions 1-6) --

def test_block_info_v1_m():
  assert_eq(_qr_block_info(1, "M"), [10, 1, 16, 0, 0])
end

def test_block_info_v3_q_two_blocks():
  assert_eq(_qr_block_info(3, "Q"), [18, 2, 17, 0, 0])
end

def test_block_info_v5_q_two_groups():
  assert_eq(_qr_block_info(5, "Q"), [18, 2, 15, 2, 16])
end

def test_block_info_v6_h():
  assert_eq(_qr_block_info(6, "H"), [28, 4, 15, 0, 0])
end

def test_block_info_invalid_level_errors():
  assert_eq(try: _qr_block_info(1, "X") catch: "caught", "caught")
end

def test_block_info_invalid_version_errors():
  assert_eq(try: _qr_block_info(7, "M") catch: "caught", "caught")
end

# -- Version selection --

def test_select_version_fits_v1():
  assert_eq(_qr_select_version(5, "M"), 1)
end

def test_select_version_v1_m_capacity_boundary():
  # V1-M byte mode capacity is 14 characters (12 header bits + 14*8 data
  # bits = 124 <= 128 available bits; 15 chars would need 132 bits).
  assert_eq(_qr_select_version(14, "M"), 1)
  | assert_eq(_qr_select_version(15, "M"), 2)
end

def test_select_version_picks_smallest_that_fits():
  assert_eq(_qr_select_version(50, "M"), 4)
end

def test_select_version_too_long_errors():
  assert_eq(try: _qr_select_version(200, "H") catch: "caught", "caught")
end

# -- Bitstream construction --

def test_build_bitstream_length():
  # 4-bit mode indicator + 8-bit count + 8 data bits for a single byte
  assert_eq(len(_qr_build_bitstream([65])), 20)
end

def test_build_bitstream_mode_indicator():
  let bits = _qr_build_bitstream([65])
  | assert_eq(slice(bits, 0, 4), [0, 1, 0, 0])
end

def test_bits_to_bytes_roundtrip():
  assert_eq(_qr_bits_to_bytes(_qr_bits_of(65, 8)), [65])
end

def test_bits_to_bytes_multiple():
  let bits = _qr_bits_of(1, 8) + _qr_bits_of(2, 8) + _qr_bits_of(255, 8)
  | assert_eq(_qr_bits_to_bytes(bits), [1, 2, 255])
end

def test_pad_bitstream_reaches_capacity():
  assert_len(_qr_pad_bitstream(_qr_bits_of(0, 0), 16), 16)
end

def test_pad_bitstream_uses_pad_bytes():
  # 8 data bits + 4 terminator bits + 4 byte-alignment bits fill exactly
  # 2 bytes (65, 0), leaving 1 byte for the standard 0xEC pad codeword.
  let bits = _qr_pad_bitstream(_qr_bits_of(65, 8), 24)
  | assert_eq(_qr_bits_to_bytes(bits), [65, 0, 236])
end

def test_pad_bitstream_too_long_errors():
  assert_eq(try: _qr_pad_bitstream(_qr_bits_of(0, 20), 8) catch: "caught", "caught")
end

# -- Block splitting / interleaving --

def test_split_blocks_single_group():
  let blocks = _qr_split_blocks([1, 2, 3, 4, 5, 6], 2, 3, 0, 0)
  | assert_eq(blocks, [[1, 2, 3], [4, 5, 6]])
end

def test_split_blocks_two_groups():
  let blocks = _qr_split_blocks([1, 2, 3, 4, 5, 6, 7], 1, 3, 2, 2)
  | assert_eq(blocks, [[1, 2, 3], [4, 5], [6, 7]])
end

def test_interleave_equal_length_blocks():
  assert_eq(_qr_interleave([[1, 2, 3], [4, 5, 6]]), [1, 4, 2, 5, 3, 6])
end

def test_interleave_uneven_length_blocks():
  assert_eq(_qr_interleave([[1, 2], [3, 4, 5]]), [1, 3, 2, 4, 5])
end

# -- qr_matrix (structure + values cross-checked against an independent
#    from-scratch QR decoder validated against the Python `qrcode` library) --

def test_qr_matrix_hello_m():
  let info = qr_matrix("HELLO", "M")
  | assert_eq(info["version"], 1)
  | assert_eq(info["ecc"], "M")
  | assert_eq(info["mask"], 2)
  | assert_eq(info["size"], 21)
end

def test_qr_matrix_hello_l():
  let info = qr_matrix("HELLO", "L")
  | assert_eq(info["version"], 1)
  | assert_eq(info["mask"], 5)
end

def test_qr_matrix_hello_h():
  let info = qr_matrix("HELLO", "H")
  | assert_eq(info["version"], 1)
  | assert_eq(info["mask"], 4)
end

def test_qr_matrix_url_selects_version_3():
  let info = qr_matrix("https://github.com/harehare/mq", "M")
  | assert_eq(info["version"], 3)
  | assert_eq(info["mask"], 0)
end

def test_qr_matrix_default_ecc_is_m():
  let info = qr_matrix("HELLO")
  | assert_eq(info["ecc"], "M")
end

def test_qr_matrix_lowercase_ecc_is_normalized():
  let info = qr_matrix("HELLO", "m")
  | assert_eq(info["ecc"], "M")
end

def test_qr_matrix_empty_string():
  let info = qr_matrix("", "M")
  | assert_eq(info["version"], 1)
  | assert_eq(info["size"], 21)
end

def test_qr_matrix_unicode_input():
  let info = qr_matrix("こんにちは世界", "M")
  | assert_eq(info["version"], 2)
end

def test_qr_matrix_dimensions_match_version():
  let info = qr_matrix("test data for version sizing", "L")
  | assert_eq(info["size"], 17 + 4 * info["version"])
  | assert_len(info["modules"], info["size"])
  | assert_len(info["modules"][0], info["size"])
end

def test_qr_matrix_modules_are_binary():
  let info = qr_matrix("HELLO", "M")
  | let all_binary = fold(info["modules"], true, fn(acc, row):
      acc && fold(row, true, fn(acc2, v): acc2 && (v == 0 || v == 1););)
  | assert_true(all_binary)
end

def test_qr_matrix_finder_pattern_corner_is_dark():
  let info = qr_matrix("HELLO", "M")
  | assert_eq(info["modules"][0][0], 1)
end

def test_qr_matrix_invalid_ecc_level_errors():
  assert_eq(try: qr_matrix("hi", "Z") catch: "caught", "caught")
end

def test_qr_matrix_too_long_for_level_errors():
  assert_eq(try: qr_matrix(repeat("x", 200), "H") catch: "caught", "caught")
end

def test_qr_matrix_multi_block_version_roundtrips_size():
  # Version 6-ish input forces multiple Reed-Solomon blocks to be
  # split, error-correction encoded, and interleaved back together.
  let info = qr_matrix(repeat("x", 100), "L")
  | assert_eq(info["size"], 17 + 4 * info["version"])
end

# -- qr_generate (ASCII rendering) --

def test_qr_generate_line_count_includes_quiet_zone():
  let output = qr_generate("HELLO", "M")
  | let lines = split(output, "\n")
  | assert_eq(len(lines), 21 + 4 * 2)
end

def test_qr_generate_line_width_includes_quiet_zone():
  let output = qr_generate("HELLO", "M")
  | let lines = split(output, "\n")
  | assert_eq(len(lines[0]), (21 + 4 * 2) * 2)
end

def test_qr_generate_quiet_zone_is_light():
  let output = qr_generate("HELLO", "M")
  | let lines = split(output, "\n")
  | assert_eq(lines[0], repeat("  ", 21 + 4 * 2))
end

def test_qr_generate_custom_characters():
  let output = qr_generate("HELLO", "M", "@@", "..")
  | assert_true(contains(output, "@@"))
  | assert_false(contains(output, "##"))
end

# -- qr_svg (SVG rendering) --

def test_qr_svg_is_well_formed():
  let output = qr_svg("HELLO", "M")
  | assert_true(contains(output, "<svg xmlns=\"http://www.w3.org/2000/svg\""))
  | assert_true(contains(output, "</svg>"))
end

def test_qr_svg_dimensions_include_quiet_zone():
  let output = qr_svg("HELLO", "M", 4)
  | let dim = (21 + 4 * 2) * 4
  | assert_true(contains(output, "viewBox=\"0 0 " + to_string(dim) + " " + to_string(dim) + "\""))
  | assert_true(contains(output, "width=\"" + to_string(dim) + "\""))
  | assert_true(contains(output, "height=\"" + to_string(dim) + "\""))
end

def test_qr_svg_rect_count_matches_dark_modules():
  let info = qr_matrix("HELLO", "M")
  | let dark_count = fold(info["modules"], 0, fn(acc, row):
      acc + fold(row, 0, fn(acc2, v): acc2 + v;);)
  | let output = qr_svg("HELLO", "M")
  | let rect_count = len(split(output, "<rect x=")) - 1
  | assert_eq(rect_count, dark_count)
end

def test_qr_svg_custom_colors():
  let output = qr_svg("HELLO", "M", 4, "#ff0000", "#00ff00")
  | assert_true(contains(output, "fill=\"#00ff00\""))
  | assert_true(contains(output, "fill=\"#ff0000\""))
end
